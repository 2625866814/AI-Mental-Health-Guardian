# 复制本文件为 .env 并填入你的真实配置（.env 不会被提交到仓库）

# ===== 服务 =====
PORT=8080
NODE_ENV=development

# ===== 数据库 =====
# 项目默认使用 SQLite（零配置即可运行）；如需 MySQL，请填写以下配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_mental_health

# ===== JWT 认证 =====
# 请替换为随机长字符串，例如: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# ===== AI 大模型 API =====
AI_API_KEY=your-api-key-here
AI_API_ENDPOINT=https://your-llm-api-endpoint/v1/chat/completions
AI_MODEL=mimo-v2-flash

# ===== 语音能力（ASR/TTS）=====
VOICE_API_KEY=your-voice-api-key-here

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== 新导入学生的初始密码 =====
INITIAL_STUDENT_PASSWORD=123456
